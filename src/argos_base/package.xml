<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>argos_base</name>
  <version>0.0.0</version>
  <description>Pilotes du robot réel : moteurs (carte Yahboom YB-ESF01)</description>
  <maintainer email="serge@todo.todo">serge</maintainer>
  <license>MIT</license>

  <!-- Dépendances à l'exécution : ce que le code Python importe -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
